# Copy to .streamlit/secrets.toml and fill in the real values.
# .streamlit/secrets.toml is gitignored — never commit it.

API_KEY        = "your-api-key"
BASE_URL       = "https://your-api-host"

# Same login credentials as the Vizva dashboard
VIZVA_USERNAME = "your-username"
VIZVA_PASSWORD = "your-password"
